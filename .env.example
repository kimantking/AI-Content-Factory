# ---- AI Content Factory / Phase 1-A ----
# Copy to .env and fill in. NEVER commit .env.

# Infrastructure
DATABASE_URL=postgresql+psycopg://acf:acf@localhost:5433/acf
SYNC_DATABASE_URL=postgresql://acf:acf@localhost:5433/acf
REDIS_URL=redis://localhost:6379/0
CHECKPOINTER_KIND=postgres            # postgres | memory

# Mode
MOCK_MODE=false                       # false = real providers; failures never become fake results
RUN_INLINE=false                      # true = API runs pipeline in-process (no Celery worker)

# LLM provider
LLM_PROVIDER=ollama                   # ollama | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_WORKSPACE_ID=               # only for an identity-linked Console key (Console → Settings → Workspaces)

# Search provider (Agent Reach is primary when AGENT_REACH_ENABLED=true;
# Tavily remains the fallback when its key is configured.)
SEARCH_PROVIDER=tavily                # mock | tavily
TAVILY_API_KEY=

# Media providers — live mode never falls back to generated Mock assets.
GOOGLE_API_KEY=
GOOGLE_AI_ENABLED=true
IMAGE_PROVIDER=google
VIDEO_PROVIDER=google
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
GOOGLE_VIDEO_MAX_WAIT_SECONDS=600

ELEVENLABS_API_KEY=
TTS_PROVIDER=elevenlabs
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Publishing/analytics/trends. These require each SNS developer app and OAuth
# credentials; missing adapters are reported as unavailable, never fake success.
DRY_RUN=false
PLATFORM_CLIENT=http
ANALYTICS_CLIENT=http
TREND_CLIENT=http
OAUTH_CLIENT_JSON={}

# Budget guard (USD)
CAMPAIGN_BUDGET_USD=2.0
DAILY_BUDGET_USD=20.0
MONTHLY_BUDGET_USD=300.0

# Pipeline guards
RESEARCH_FIX_MAX=2
FACT_SCORE_THRESHOLD=0.6

# Natural Content Engine (Design Amendment)
NATURAL_WRITING_ENABLED=true
MAX_AI_SLOP_SCORE=20
DEFAULT_BRAND=default

# ================================================================
# Phase 5 — Production / Security / Backup / Monitoring / Recovery
# Names only. Fill values in .env (never commit). In production,
# app boot HARD-FAILS if SECRET_KEY / ACF_MASTER_KEY are unset or
# if CORS_ALLOW_ORIGINS / TRUSTED_HOSTS is left as "*".
# ================================================================

# Environment / release
APP_ENV=development                   # development | test | staging | production
APP_VERSION=1.0.0

# Local AI (Phase 8/11) — free, offline. Windows host: keep localhost here;
# docker-compose.yml rewrites this to http://host.docker.internal:11434 for the
# backend/worker containers automatically (extra_hosts: host-gateway on Linux).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b        # ollama pull gemma3:4b
ALLOW_CLOUD_FALLBACK=false            # keep failed cloud credentials out of local runs

# Agent Reach — read-only web/YouTube/GitHub/RSS tooling. Cookie channels remain off.
AGENT_REACH_ENABLED=true

# Web security (required when APP_ENV=production)
SECRET_KEY=                           # session/CSRF signing key
ACF_MASTER_KEY=                       # credential-encryption key, SEPARATE from the DB
TRUSTED_HOSTS=*                       # JSON list or comma list; must NOT be "*" in prod
CORS_ALLOW_ORIGINS=*                  # JSON list or comma list; must NOT be "*" in prod
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
OAUTH_CALLBACK_BASE_URL=http://localhost:8000

# Request / upload limits
MAX_REQUEST_BYTES=25000000
MAX_UPLOAD_BYTES=300000000
RATE_LIMIT_ENABLED=true

# SSRF egress control
SSRF_ENFORCE=true
SSRF_ALLOW_HOSTS=                     # JSON/comma list of extra allowed hosts

# Backup / restore
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=7
BACKUP_DESTINATION=local              # local | s3
BACKUP_ENCRYPTION_KEY=               # optional Fernet key to encrypt dumps at rest
PG_DUMP_CMD=                          # explicit path; blank = PATH, else docker exec
PG_RESTORE_CMD=
POSTGRES_CONTAINER=ai-content-factory-postgres-1

# Workers / queue / circuit breaker
RENDER_MAX_CONCURRENCY=2
PROVIDER_BREAKER_THRESHOLD=5
PROVIDER_BREAKER_COOLDOWN_S=120
PROVIDER_BREAKER_PROBES=1
QUEUE_BACKPRESSURE_WARN=50
QUEUE_BACKPRESSURE_HOLD=200
WORKER_HEARTBEAT_STALE_S=90
JOB_LEASE_SECONDS=1800

# Monitoring thresholds
DISK_WARN_PCT=85.0
DISK_CRITICAL_PCT=95.0
COST_ANOMALY_FACTOR=4.0
LOG_LEVEL=INFO

# Optional observability adapters (env-gated no-ops when unset)
OTEL_ENABLED=false
SENTRY_DSN=

# --- docker-compose.prod.yml only (not read by the app) ---
POSTGRES_PASSWORD=                    # compose: postgres superuser password
REDIS_PASSWORD=                       # compose: redis requirepass
PROXY_DOMAIN=acf.example.com          # compose --profile proxy: Caddy site address
ACME_EMAIL=                           # compose --profile proxy: Let's Encrypt email
