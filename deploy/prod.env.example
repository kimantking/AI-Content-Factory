# Copy to deploy/prod.env (git-ignored) and fill in real values.
# Used by: docker compose --env-file deploy/prod.env -f docker-compose.yml -f docker-compose.prod.yml ...
# The compose file has ${VAR:?} guards — it will NOT start until the required ones are set.

# --- required: secrets ---
POSTGRES_PASSWORD=
REDIS_PASSWORD=
SECRET_KEY=
ACF_MASTER_KEY=

# --- required: public identity ---
CORS_ALLOW_ORIGINS=https://app.example.com
TRUSTED_HOSTS=app.example.com
PUBLIC_BASE_URL=https://app.example.com
OAUTH_CALLBACK_BASE_URL=https://app.example.com/api/publishing/oauth/callback

# --- optional: Caddy TLS proxy (--profile proxy) ---
PROXY_DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

# --- optional: backups / observability ---
BACKUP_ENCRYPTION_KEY=
SENTRY_DSN=
OTEL_ENABLED=false
