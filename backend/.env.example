# AI Content Factory — environment template. Copy to .env and fill in.
# Never commit a real .env. Secrets stay out of the repository.
# Frontend never receives a secret — no NEXT_PUBLIC_* for any API key.

# ---- Infrastructure ----
DATABASE_URL=postgresql+psycopg://acf:acf@localhost:5433/acf
SYNC_DATABASE_URL=postgresql://acf:acf@localhost:5433/acf
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
MOCK_MODE=false

# ---- Cloud LLM + Search (live mode fails clearly when not connected) ----
LLM_PROVIDER=ollama               # ollama | anthropic (real mode never silently falls back to mock)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
SEARCH_PROVIDER=tavily            # mock | tavily
TAVILY_API_KEY=

# ---- Google AI — image (Imagen) + video (Veo). Backend only. ----
GOOGLE_API_KEY=
GOOGLE_AI_ENABLED=true
IMAGE_PROVIDER=google             # mock | google
VIDEO_PROVIDER=google             # mock | google
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_VIDEO_MODEL=veo-3.1-generate-preview
GOOGLE_VIDEO_MAX_WAIT_SECONDS=600

# ---- ElevenLabs — voice / TTS. Backend only. ----
ELEVENLABS_API_KEY=
TTS_PROVIDER=elevenlabs           # mock is allowed only when MOCK_MODE=true
ELEVENLABS_VOICE_ID=              # required when TTS_PROVIDER=elevenlabs (no invented default)
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---- Local AI (Ollama) — Phase 8 ----
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=gemma3:4b
ALLOW_CLOUD_FALLBACK=false        # false => LOCAL_ONLY (no cloud LLM calls)
LOCAL_MODEL_MAX_CONCURRENCY=2
LOCAL_MODEL_TIMEOUT_SECONDS=120

# ---- Model Router / cost ----
MODEL_ROUTER_ENABLED=true
QUALITY_PRESET=balanced          # fast | balanced | high | max
MODEL_ROUTING_MIN_SAMPLE=8

# ---- SNS live services (developer apps + OAuth credentials required) ----
DRY_RUN=false
PLATFORM_CLIENT=http
ANALYTICS_CLIENT=http
TREND_CLIENT=http
OAUTH_CLIENT_JSON={}

# ---- Learning (Cross-Phase Intelligence Upgrade) ----
MAX_LEARNED_CONTEXT_TOKENS=1500
MAX_LEARNED_SKILLS=8
MAX_PROMPT_BLUEPRINTS=5
AUTO_PROMOTE_LEARNED_PROMPTS=false

# ---- Security (set real values in production) ----
SECRET_KEY=
ACF_MASTER_KEY=
WEBHOOK_SECRET=

# ---- UI ----
UI_MODE_DEFAULT=BEGINNER          # BEGINNER | STANDARD | EXPERT
